{
  "name": "nexus-enterprise-agent",
  "version": "0.1.0",
  "description": "Enterprise-ready, SaaS-native TypeScript multi-agent framework",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nexus": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "import": "./dist/realtime/index.js"
    },
    "./skills": {
      "types": "./dist/skills/index.d.ts",
      "import": "./dist/skills/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; import { execSync } from 'node:child_process'; if (existsSync('src/index.ts')) execSync('npm run build', { stdio: 'inherit' });\"",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "NEXUS_LIVE_LLM=1 vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agents",
    "llm",
    "multi-agent",
    "saas",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gowrav-vishwakarma/nexus-enterprise-agent-js.git"
  },
  "dependencies": {
    "ai": "^5.0.0",
    "@ai-sdk/openai-compatible": "^1.0.0",
    "js-tiktoken": "^1.0.20",
    "nunjucks": "^3.2.4",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/groq": "^2.0.0",
    "@ai-sdk/amazon-bedrock": "^3.0.0",
    "@ai-sdk/azure": "^2.0.0",
    "@libsql/client": "^0.15.0",
    "postgres": "^3.4.5",
    "ioredis": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/nunjucks": "^3.2.6",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
